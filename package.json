{
  "name": "plume-journal",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "new-post": "node scripts/new-post.mjs",
    "check:handoff": "node handoff/codex/scripts/check-handoff.mjs",
    "deploy": "astro build && npx wrangler deploy",
    "preview:cf": "astro build && npx wrangler dev",
    "build:drafts": "SHOW_DRAFTS=1 astro build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "6.3.7",
    "@astrojs/rss": "4.0.14",
    "@astrojs/sitemap": "3.6.0",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@resvg/resvg-js": "2.6.2",
    "astro": "5.13.10",
    "mdast-util-to-string": "4.0.0",
    "pagefind": "1.4.0",
    "satori": "0.63.2",
    "sharp": "0.34.5"
  }
}
