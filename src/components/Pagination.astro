---
import type { Page } from "astro";
import Icon from "./Icon.astro";

interface Props {
	page: Page<unknown>;
}
const { page } = Astro.props;
---
{page.lastPage > 1 && (
	<nav class="pager" aria-label="分页">
		{page.url.prev ? (
			<a href={page.url.prev} class="pg-link"><Icon name="arrow-left" size={18} />上一页</a>
		) : <span />}
		<span class="pg-num latin">{page.currentPage} <span aria-hidden="true">/</span> {page.lastPage}</span>
		{page.url.next ? (
			<a href={page.url.next} class="pg-link">下一页<Icon name="arrow-right" size={18} /></a>
		) : <span />}
	</nav>
)}

<style>
	.pager {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding-top: var(--s5);
	}
	.pg-link {
		display: inline-flex;
		align-items: center;
		gap: var(--s2);
		height: 44px;
		padding: 0 var(--s3);
		border-radius: var(--r-btn);
		color: var(--c-secondary);
		font-size: var(--fs-small);
		justify-self: start;
	}
	.pg-link:last-child {
		justify-self: end;
	}
	.pg-link:hover {
		background: var(--c-container);
		color: var(--c-on-container);
	}
	.pg-num {
		font-size: var(--fs-h3);
		color: var(--c-accent);
	}
</style>
