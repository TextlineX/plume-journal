---
// Q 版贴纸位：src/assets/stickers/<name>.webp 存在就显示，否则显示占位（slot）。
// Codex 放进文件后重新构建即可，不用改代码（见交接包 03-stickers.md）。
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	name: string;
	size: number;
}
const { name, size } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/stickers/*.webp", { eager: true });
const img = files[`/src/assets/stickers/${name}.webp`]?.default;
---
{img ? <Image src={img} alt="" width={size} height={size} densities={[1, 2]} /> : <slot />}
