---
import { site } from "../site.config";
const year = new Date().getFullYear();
---
<footer class="footer">
	<div class="rule" aria-hidden="true"><span class="diamond"></span></div>
	<p class="caption">
		© {year} {site.author}
		<span aria-hidden="true">·</span> <a href="/rss.xml">RSS</a>
		<span aria-hidden="true">·</span> <a href="/sitemap-index.xml">站点地图</a>
		<span aria-hidden="true">·</span> 用 <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> 搭建
	</p>
</footer>

<style>
	.footer {
		padding: 0 var(--s7) var(--s5) var(--s6);
		max-width: calc(var(--content-max) + var(--s7) + var(--s6));
	}
	.footer .rule {
		margin-bottom: var(--s3);
	}
	.footer a {
		color: var(--c-secondary);
		text-decoration: underline;
		text-decoration-color: var(--c-hairline);
		text-underline-offset: 3px;
	}
	.footer a:hover {
		color: var(--c-link);
	}
	@media (max-width: 1023px) {
		.footer {
			padding: 0 var(--s5) var(--s5);
			max-width: calc(var(--content-max) + 2 * var(--s5));
			margin: 0 auto;
			width: 100%;
		}
	}
	@media (max-width: 767px) {
		.footer {
			padding: 0 var(--s3) var(--s4);
		}
	}
</style>
