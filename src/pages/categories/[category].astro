---
import ArchiveList from "../../components/ArchiveList.astro";
import TermCloud from "../../components/TermCloud.astro";
import Base from "../../layouts/Base.astro";
import { getPosts, type Post } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	const cats = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[];
	return cats.map((category) => ({ params: { category }, props: { category, all: posts } }));
}
const { category, all } = Astro.props as { category: string; all: Post[] };
const list = all.filter((p) => p.data.category === category);
---
<Base title={`分类：${category}`} description={`分类「${category}」下的文章`}>
	<header class="page-head">
		<span class="eyebrow">Category</span>
		<h1>{category}</h1>
		<p>这个分类下有 {list.length} 篇。</p>
	</header>
	<TermCloud posts={all} current={{ type: "category", value: category }} />
	<ArchiveList posts={list} />
</Base>
