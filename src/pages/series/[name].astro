---
import ArchiveList from "../../components/ArchiveList.astro";
import Base from "../../layouts/Base.astro";
import { allSeries, getPosts, type Post, seriesOf } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return allSeries(posts).map((name) => ({ params: { name }, props: { name, list: seriesOf(posts, name) } }));
}
const { name, list } = Astro.props as { name: string; list: Post[] };
---
<Base title={`系列：${name}`} description={`系列「${name}」的全部文章`}>
	<header class="page-head">
		<span class="eyebrow">Series</span>
		<h1>{name}</h1>
		<p>这个系列共 {list.length} 篇，按阅读顺序排列。</p>
	</header>
	<ol class="series-list">
		{list.map((p, i) => (
			<li>
				<span class="sl-i latin">{String(i + 1).padStart(2, "0")}</span>
				<a href={`/posts/${p.id}/`} class="serif">{p.data.title}</a>
				{p.data.description && <p class="sl-desc">{p.data.description}</p>}
			</li>
		))}
	</ol>
</Base>

<style>
	.series-list {
		list-style: none;
		padding: 0;
		max-width: var(--content-max);
		border-bottom: 1px solid var(--c-border);
	}
	.series-list li {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr);
		gap: 4px var(--s3);
		padding: var(--s4) 0;
		border-top: 1px solid var(--c-border);
	}
	.sl-i {
		grid-row: span 2;
		font-size: var(--fs-h2);
		line-height: var(--lh-h2);
		color: var(--c-accent);
	}
	.series-list a {
		font-size: var(--fs-h3);
		line-height: var(--lh-h3);
		color: var(--c-strong);
	}
	.series-list a:hover {
		color: var(--c-link);
	}
	.sl-desc {
		color: var(--c-secondary);
	}
</style>
