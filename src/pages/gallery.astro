---
// 相册：像贴在手帐页上的照片——白边、轻微错落的旋转角度、底下手写感的标注（宋体）。
// 点击放大用原生 <dialog>，键盘左右键切换。
import { Image } from "astro:assets";
import EmptyState from "../components/EmptyState.astro";
import Icon from "../components/Icon.astro";
import { photos } from "../data/gallery";
import Base from "../layouts/Base.astro";

const tilt = [-1.2, 0.8, -0.4, 1.1, -0.9, 0.5, -1.4, 0.9];
---
<Base title="相册" description="随手拍的照片">
	<header class="page-head">
		<span class="eyebrow">Album</span>
		<h1>相册</h1>
		{photos.length > 0 && <p>共 {photos.length} 张。点开看大图，左右方向键切换。</p>}
	</header>
	{photos.length === 0 && <EmptyState title="相册还是空的" text="拍到喜欢的照片，会贴在这一页。" />}
	<ul class="album">
		{photos.map((p, i) => (
			<li class="photo" style={`--tilt:${tilt[i % tilt.length]}deg`}>
				<button type="button" class="photo-btn" data-index={i} aria-label={`查看大图：${p.title}`}>
					<Image src={p.src} alt={p.title} widths={[320, 640]} sizes="(max-width: 767px) 50vw, 240px" class="photo-img" />
				</button>
				<p class="photo-cap"><span class="serif">{p.title}</span>{p.date && <span class="caption"> · {p.date}</span>}</p>
			</li>
		))}
	</ul>

	<dialog class="lightbox" id="lightbox" aria-label="大图">
		<button type="button" class="icon-btn lb-close" data-close-dialog aria-label="关闭"><Icon name="close" /></button>
		<button type="button" class="icon-btn lb-nav lb-prev" aria-label="上一张"><Icon name="arrow-left" /></button>
		<figure>
			<img id="lb-img" alt="" />
			<figcaption id="lb-cap" class="caption"></figcaption>
		</figure>
		<button type="button" class="icon-btn lb-nav lb-next" aria-label="下一张"><Icon name="arrow-right" /></button>
	</dialog>
	<script is:inline type="application/json" id="album-data" set:html={JSON.stringify(photos.map((p) => ({ src: p.src.src, title: p.title, date: p.date ?? "" })))} />
</Base>

<script>
	function setup() {
		const dlg = document.getElementById("lightbox") as HTMLDialogElement | null;
		const raw = document.getElementById("album-data");
		if (!dlg || !raw) return;
		const data: { src: string; title: string; date: string }[] = JSON.parse(raw.textContent || "[]");
		const img = document.getElementById("lb-img") as HTMLImageElement;
		const cap = document.getElementById("lb-cap")!;
		let i = 0;
		const show = (n: number) => {
			i = (n + data.length) % data.length;
			img.src = data[i].src;
			img.alt = data[i].title;
			cap.textContent = `${data[i].title}${data[i].date ? ` · ${data[i].date}` : ""}　${i + 1} / ${data.length}`;
		};
		document.querySelectorAll<HTMLButtonElement>(".photo-btn").forEach((b) =>
			b.addEventListener("click", () => {
				show(Number(b.dataset.index));
				dlg.showModal();
			}),
		);
		dlg.querySelector(".lb-prev")!.addEventListener("click", () => show(i - 1));
		dlg.querySelector(".lb-next")!.addEventListener("click", () => show(i + 1));
		dlg.addEventListener("keydown", (e) => {
			if (e.key === "ArrowLeft") show(i - 1);
			if (e.key === "ArrowRight") show(i + 1);
		});
	}
	document.addEventListener("astro:page-load", setup);
</script>

<style>
	.album {
		list-style: none;
		padding: 0;
		max-width: var(--content-max);
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--s5) var(--s4);
	}
	.photo {
		transform: rotate(var(--tilt));
		transition: transform var(--dur-medium2) var(--ease-standard);
	}
	.photo:hover {
		transform: rotate(0deg) translateY(-4px);
	}
	.photo-btn {
		display: block;
		width: 100%;
		padding: 8px 8px 0;
		background: var(--c-surface);
		border-radius: 4px;
		box-shadow: 0 1px 2px rgb(46 43 54 / 0.08), 0 8px 20px rgb(110 102 153 / 0.12);
	}
	:global([data-theme="dark"]) .photo-btn {
		box-shadow: 0 0 0 1px var(--c-hairline);
	}
	.photo-btn :global(.photo-img) {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 2px;
	}
	.photo-btn::after {
		content: "";
		display: block;
		height: 28px;
	}
	.photo-cap {
		margin-top: var(--s2);
		text-align: center;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--c-secondary);
	}

	.lightbox {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: var(--s6) var(--s8);
		border: 0;
		background: rgb(10 9 20 / 0.92);
		color: #e2def2;
	}
	.lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.lightbox figure {
		max-width: 100%;
		max-height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--s3);
	}
	.lightbox img {
		max-width: 100%;
		max-height: calc(100vh - 160px);
		object-fit: contain;
		border-radius: 4px;
	}
	.lightbox .caption {
		color: #cfc9e6;
	}
	.lightbox .icon-btn {
		color: #e2def2;
	}
	.lightbox .icon-btn:hover {
		background: rgb(255 255 255 / 0.1);
		color: #fff;
	}
	.lb-close {
		position: absolute;
		top: var(--s3);
		right: var(--s3);
	}
	.lb-nav {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
	}
	.lb-prev {
		left: var(--s4);
	}
	.lb-next {
		right: var(--s4);
	}
	@media (max-width: 767px) {
		.album {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--s4) var(--s3);
		}
		.lightbox {
			padding: var(--s7) var(--s3);
		}
		.lb-nav {
			top: auto;
			bottom: var(--s3);
			translate: none;
		}
	}
</style>
