---
// 文章页：像一页排好的书。正文单栏 680（40 字）；本文目录放在右侧页边（参考 Tufte 页边注排法），
// 宽度不够时收进正文上方的折叠面板。文末：读完啦 → 标签与许可 → 上一篇 / 下一篇。
import { Image } from "astro:assets";
import { render } from "astro:content";
import Comments from "../../components/Comments.astro";
import Icon from "../../components/Icon.astro";
import Sticker from "../../components/Sticker.astro";
import Base from "../../layouts/Base.astro";
import { categoryUrl, fmtDate, getPosts, pad, type Post, postUrl, tagUrl } from "../../lib/posts";
import { license, site } from "../../site.config";
import "../../styles/prose.css";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const { Content, headings, remarkPluginFrontmatter: fm } = await render(post);
const { data } = post;
const toc = headings.filter((h) => h.depth <= 3 && h.slug !== "footnote-label");
---
<Base title={data.title} description={data.description || site.subtitle} ogType="article" slim ogImage={`/og/posts/${post.id}.png`} published={data.published} updated={data.updated}>
	<div class="post">
		<header class="post-head">
			<a href="/" class="back caption"><Icon name="arrow-left" size={16} />目录</a>
			<p class="post-meta caption">
				<span class="latin post-no">No. {pad(post.no)}</span>
				{data.category && (
					<>
						<span class="dot" aria-hidden="true"></span>
						<a href={categoryUrl(data.category)} class="post-cat">{data.category}</a>
					</>
				)}
				<span class="dot" aria-hidden="true"></span>
				<time datetime={data.published.toISOString()}>{fmtDate(data.published)}</time>
				<span class="dot" aria-hidden="true"></span>
				<span>{fm.words.toLocaleString()} 字 · {fm.minutes} 分钟</span>
			</p>
			<h1 class="post-title serif" data-pagefind-meta="title">{data.title}</h1>
			{data.description && <p class="post-desc">{data.description}</p>}
		</header>

		<div class="post-grid">
			<article class="post-body" data-pagefind-body>
				{toc.length > 1 && (
					<details class="toc-fold" data-pagefind-ignore>
						<summary>本文目录</summary>
						<ol>
							{toc.map((h) => <li class:list={{ sub: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}
						</ol>
					</details>
				)}
				{data.image && (
					<figure class="post-cover">
						<Image src={data.image} alt="" widths={[680, 1360]} sizes="(max-width: 767px) 100vw, 680px" />
					</figure>
				)}
				<div class="prose">
					<Content />
				</div>

				<footer class="post-end" data-pagefind-ignore>
					<div class="end-mark" aria-hidden="true">
						<Sticker name="reading" size={72}><span class="end-diamond"></span></Sticker>
					</div>
					<div>
						<p class="end-title serif">读完啦</p>
						<p class="caption">
							{data.updated ? `最后更新于 ${fmtDate(data.updated)}` : `写于 ${fmtDate(data.published)}`}
							<span aria-hidden="true"> · </span>
							<a href={license.url} target="_blank" rel="noopener license" class="end-license">{license.name}</a>
						</p>
					</div>
				</footer>

				{data.tags.length > 0 && (
					<ul class="post-tags" aria-label="标签" data-pagefind-ignore>
						{data.tags.map((t) => <li><a href={tagUrl(t)}># {t}</a></li>)}
					</ul>
				)}

				<nav class="post-nav" aria-label="上一篇和下一篇" data-pagefind-ignore>
					{older ? (
						<a href={postUrl(older)} class="pn">
							<span class="caption pn-label"><Icon name="arrow-left" size={14} />上一篇</span>
							<span class="pn-title serif">{older.data.title}</span>
						</a>
					) : <span />}
					{newer ? (
						<a href={postUrl(newer)} class="pn pn-next">
							<span class="caption pn-label">下一篇<Icon name="arrow-right" size={14} /></span>
							<span class="pn-title serif">{newer.data.title}</span>
						</a>
					) : <span />}
				</nav>

				<Comments />
			</article>

			{toc.length > 1 && (
				<aside class="post-aside" aria-label="本文目录">
					<p class="aside-title"><span class="latin">Index</span> 本文目录</p>
					<ol class="aside-toc" id="aside-toc">
						{toc.map((h) => (
							<li class:list={{ sub: h.depth === 3 }}>
								<a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
							</li>
						))}
					</ol>
				</aside>
			)}
		</div>
	</div>
</Base>

<script>
	// 页边目录高亮当前章节；代码块加复制按钮
	function setup() {
		const links = [...document.querySelectorAll<HTMLAnchorElement>("#aside-toc a")];
		if (links.length) {
			const heads = links.map((a) => document.getElementById(a.dataset.slug!)).filter(Boolean) as HTMLElement[];
			const onScroll = () => {
				let cur = heads[0]?.id;
				for (const h of heads) if (h.getBoundingClientRect().top < 140) cur = h.id;
				links.forEach((a) => a.classList.toggle("active", a.dataset.slug === cur));
			};
			onScroll();
			window.addEventListener("scroll", onScroll, { passive: true });
			document.addEventListener("astro:before-swap", () => window.removeEventListener("scroll", onScroll), { once: true });
		}
		document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
			if (pre.querySelector(".copy-btn")) return;
			const b = document.createElement("button");
			b.type = "button";
			b.className = "copy-btn";
			b.textContent = "复制";
			b.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? "");
					b.textContent = "已复制";
				} catch {
					b.textContent = "复制失败";
				}
				setTimeout(() => (b.textContent = "复制"), 1600);
			});
			pre.appendChild(b);
		});
	}
	document.addEventListener("astro:page-load", setup);
</script>

<style>
	.post {
		max-width: calc(var(--measure) + var(--s6) + var(--aside-w));
	}
	/* 超宽屏：文章（正文 + 页边目录）在版心里居中 */
	@media (min-width: 1600px) {
		.post {
			margin-inline: auto;
		}
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		margin-bottom: var(--s4);
		color: var(--c-muted);
	}
	.back:hover {
		color: var(--c-link);
	}
	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--s2);
	}
	.post-no {
		font-size: var(--fs-small);
		color: var(--c-accent);
		letter-spacing: 0.04em;
	}
	.dot {
		width: 4px;
		height: 4px;
		background: var(--c-gold);
		transform: rotate(45deg);
	}
	.post-cat {
		color: var(--c-gold-strong);
	}
	.post-cat:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.post-title {
		margin-top: var(--s3);
		max-width: var(--measure);
		font-size: var(--fs-h1);
		line-height: var(--lh-h1);
		color: var(--c-strong);
		letter-spacing: 0.04em;
	}
	.post-desc {
		margin-top: var(--s3);
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-weight: 600;
		color: var(--c-secondary);
	}
	.post-grid {
		margin-top: var(--s6);
		padding-top: var(--s6);
		border-top: 1px solid var(--c-border);
		display: grid;
		grid-template-columns: minmax(0, var(--measure)) var(--aside-w);
		gap: var(--s6);
		align-items: start;
	}
	.post-body {
		min-width: 0;
	}
	.post-cover {
		margin-bottom: var(--s5);
	}
	.post-cover :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--r-card);
	}

	/* ---- 页边目录 ---- */
	.post-aside {
		position: sticky;
		top: var(--s8);
	}
	.aside-title {
		font-size: var(--fs-caption);
		line-height: var(--lh-caption);
		color: var(--c-muted);
		padding-bottom: var(--s2);
		border-bottom: 1px solid var(--c-border);
		margin-bottom: var(--s2);
	}
	.aside-title .latin {
		font-style: italic;
		font-size: var(--fs-small);
		color: var(--c-accent);
		margin-right: 4px;
	}
	.aside-toc {
		list-style: none;
		padding: 0;
	}
	.aside-toc a {
		position: relative;
		display: block;
		padding: 6px 0 6px var(--s3);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--c-muted);
		transition: color var(--dur-short3) var(--ease-standard);
	}
	.aside-toc .sub a {
		padding-left: var(--s5);
		font-size: var(--fs-caption);
	}
	.aside-toc a::before {
		content: "";
		position: absolute;
		left: 0;
		top: 15px;
		width: 5px;
		height: 5px;
		transform: rotate(45deg);
		border: 1px solid var(--c-hairline);
		transition: background-color var(--dur-short3) var(--ease-standard), border-color var(--dur-short3) var(--ease-standard);
	}
	.aside-toc .sub a::before {
		left: var(--s3);
	}
	.aside-toc a:hover {
		color: var(--c-link);
	}
	.aside-toc a.active {
		color: var(--c-strong);
	}
	.aside-toc a.active::before {
		background: var(--c-gold);
		border-color: var(--c-gold);
	}

	/* ---- 折叠目录（窄屏） ---- */
	.toc-fold {
		display: none;
		margin-bottom: var(--s5);
		border-radius: var(--r-btn);
		background: var(--c-container);
		color: var(--c-on-container);
	}
	.toc-fold summary {
		height: 44px;
		display: flex;
		align-items: center;
		padding: 0 var(--s3);
		font-size: var(--fs-small);
		font-weight: 500;
		cursor: pointer;
	}
	.toc-fold ol {
		padding: 0 var(--s3) var(--s3) var(--s6);
		font-size: var(--fs-small);
		line-height: var(--lh-body);
	}
	.toc-fold .sub {
		margin-left: var(--s3);
	}

	/* ---- 文末 ---- */
	.post-end {
		display: flex;
		align-items: center;
		gap: var(--s3);
		margin-top: var(--s7);
		padding-top: var(--s5);
		border-top: 1px solid var(--c-border);
	}
	.end-mark {
		width: 72px;
		height: 72px;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: var(--r-card);
		background: var(--c-container);
	}
	.end-diamond {
		width: 14px;
		height: 14px;
		background: var(--c-gold);
		transform: rotate(45deg);
	}
	.end-title {
		font-size: var(--fs-h3);
		line-height: var(--lh-h3);
		color: var(--c-strong);
	}
	.end-license {
		color: var(--c-secondary);
		text-decoration: underline;
		text-decoration-color: var(--c-hairline);
		text-underline-offset: 3px;
	}
	.post-tags {
		list-style: none;
		padding: 0;
		margin-top: var(--s4);
		display: flex;
		flex-wrap: wrap;
		gap: var(--s2);
	}
	.post-tags a {
		display: inline-flex;
		align-items: center;
		height: 32px;
		padding: 0 12px;
		border-radius: 999px;
		border: 1px solid var(--c-hairline);
		font-size: var(--fs-caption);
		color: var(--c-secondary);
	}
	.post-tags a:hover {
		background: var(--c-container);
		border-color: var(--c-container);
		color: var(--c-on-container);
	}
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--s4);
		margin-top: var(--s6);
	}
	.pn {
		display: flex;
		flex-direction: column;
		gap: var(--s1);
		padding: var(--s3) 0;
		border-top: 1px solid var(--c-hairline);
	}
	.pn-next {
		text-align: right;
		align-items: flex-end;
	}
	.pn-label {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}
	.pn-title {
		font-size: var(--fs-body);
		line-height: var(--lh-small);
		color: var(--c-strong);
		transition: color var(--dur-short3) var(--ease-standard);
	}
	.pn:hover .pn-title {
		color: var(--c-link);
	}

	/* 页边目录需要 680 + 48 + 224 = 952 的内容宽度，按内容区实际宽度判断 */
	@container (max-width: 951px) {
		.post-grid {
			grid-template-columns: minmax(0, var(--measure));
		}
		.post-aside {
			display: none;
		}
		.toc-fold {
			display: block;
		}
	}
	@media (max-width: 767px) {
		.post-grid {
			margin-top: var(--s4);
			padding-top: var(--s4);
		}
		.post-nav {
			grid-template-columns: 1fr;
		}
		.pn-next {
			text-align: left;
			align-items: flex-start;
		}
	}
</style>
