# Cloudflare Workers 静态资源响应头（https://developers.cloudflare.com/workers/static-assets/headers/）

# 构建产物文件名带内容哈希，可以长期缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 搜索索引：每次构建会变，短缓存
/pagefind/*
  Cache-Control: public, max-age=3600

# giscus 用 crossorigin="anonymous" 加载自定义主题，需要跨域头
/giscus/*
  Access-Control-Allow-Origin: https://giscus.app
  Cache-Control: public, max-age=86400

# 分享卡片图
/og/*
  Cache-Control: public, max-age=86400
